{
  "name": "angularjs",
  "license": "MIT",
  "version": "1.8.5",
  "branchVersion": "^1.8.0",
  "branchPattern": "1.8.*",
  "distTag": "latest",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/PebblePad/angular/angular.js.git"
  },
  "engines": {
    "node": "^24.00.0",
    "npm": "^11.6.0"
  },
  "scripts": {
    "build": "node ./build-scripts/BuildDist.js",
    "deploy": "npm run build && node ./deploy-scripts/deploy.js",
    "deploy:skip-npm": "npm run build && node ./deploy-scripts/deploy.js --skip-npm",
    "test": "npm run test:build && jest",
    "test:log": "npm run test:build && jest 2>&1 | tee jest.log",
    "test:build": "node ./build-scripts/BuildDist.js --test",
    "test:playwright": "npm run test:build && jest --config=jest.config.playwright.mjs",
    "test:playwright:log": "npm run test:build && jest --config=jest.config.playwright.mjs 2>&1 | tee jest-playwright.log",
    "test:all": "npm run test && npm run test:playwright && npm run test:e2e",
    "test:e2e": "npm run test:e2e:build && npm run test:e2e:run",
    "test:e2e:build": "npm run build",
    "test:e2e:serve": "node test/e2e/server.cjs",
    "test:e2e:run": "node ./node_modules/.bin/playwright test",
    "test:e2e:dev": "npm run test:e2e:build && npm run test:e2e:serve"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@swc/core": "^1.15.8",
    "express": "^5.2.1",
    "http-server": "^14.1.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jquery": "^2.1.0"
  }
}